APP_NAME=Bhu-Lekh API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=True

DATABASE_URL=postgresql+asyncpg://bhulekh_user:bhulekh_password@localhost:5432/bhulekh_db
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=land-records

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Phase G: Layered Extraction (Ollama is optional — leave defaults if not using local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
EXTRACTION_CONFIDENCE_THRESHOLD=0.8
